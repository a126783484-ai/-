import { useRouter } from 'next/router';
import { useSession } from 'next-auth/react';
import { supabase } from '../lib/supabase';

const Layout = ({ children }) => {
  const router = useRouter();
  const { data: session } = useSession();

  useEffect(() => {
    if (!session) {
      router.push('/login');
    }
  }, [session, router]);

  return (
    <div>
      {children}
    </div>
  );
};

export default Layout;