{
  "name": "beauty-nail-os",
  "version": "0.1.0",
  "private": true,
  "description": "手機優先、SaaS 化的美甲美容行業營運 OS",
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:production-env && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "guard:production": "node scripts/production-guard.mjs",
    "db:types": "echo 'Supabase types can be generated with: supabase gen types typescript --project-id <id> > src/lib/database.types.ts'",
    "verify:production-env": "node scripts/verify-production-env.mjs",
    "audit:security": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.87.1",
    "@vercel/analytics": "1.5.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.7",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.9.2"
}
